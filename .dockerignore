# Keeps the Docker build context small, backend/api's Dockerfile builds from
# the repo root (needs the sibling backend/scanner-core), so without this
# every Docker build would upload node_modules, .venv, .git, etc.
node_modules/
**/node_modules/
.next/
**/.next/
.venv/
**/.venv/
__pycache__/
**/__pycache__/
.git/
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
*.pyc
.env
.env.*
!.env.example
env.txt
dist/
build/
.playwright-mcp/
test-results/
playwright-report/
