# Supabase — see https://supabase.com/dashboard/project/onwijviiwtuwldjmqoam/settings/api
# No JWT secret needed: auth tokens are verified against the project's JWKS
# endpoint (supports both current asymmetric signing keys and legacy HS256
# tokens during a rotation window) — see src/aevrin_api/security.py.
SUPABASE_URL=https://onwijviiwtuwldjmqoam.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-side pepper for HMAC-hashing CLI API keys — generate with `openssl rand -hex 32`
API_KEY_PEPPER=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aevrin-report
R2_S3_ENDPOINT=

# GitHub — used for Scorecard, OSV/private-repo rate limits, and private clone auth
GITHUB_TOKEN=

# DefectDojo (Section 5) — leave unset until it's deployed; the scan pipeline
# runs fine without it, DefectDojo push is best-effort and non-blocking
DEFECTDOJO_URL=
DEFECTDOJO_API_KEY=

WEB_ORIGIN=http://localhost:3000
PORT=8000
