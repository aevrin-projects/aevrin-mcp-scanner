#!/bin/sh
# `python -m semgrep` no longer runs a scan: since 1.38.0 it prints a
# deprecation notice and exits, so the adapter saw an empty result. Invoke the
# console script itself instead, still through the system interpreter so
# nothing depends on the shebang under /opt being executable.
PYTHONPATH="/opt/uv-tools/semgrep/lib/python3.11/site-packages" \
  exec /usr/local/bin/python /opt/uv-tools/semgrep/bin/semgrep "$@"
