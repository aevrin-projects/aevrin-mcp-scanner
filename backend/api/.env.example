# Every variable the API reads is listed here. Anything left blank is
# optional: the feature it powers reports itself unavailable rather than
# erroring, so a partial setup still runs.

# --- Supabase (required) ---------------------------------------------------
# https://supabase.com/dashboard/project/onwijviiwtuwldjmqoam/settings/api
# No JWT secret needed: auth tokens are verified against the project's JWKS
# endpoint (supports both current asymmetric signing keys and legacy HS256
# tokens during a rotation window); see src/aevrin_api/core/security.py.
SUPABASE_URL=https://onwijviiwtuwldjmqoam.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-side pepper for HMAC-hashing CLI API keys, generate with `openssl rand -hex 32`
API_KEY_PEPPER=

# --- Upstash Redis (required): rate limits and quota counters ---------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional spare instance. Upstash's free tier caps monthly requests and
# errors on every command once that is reached rather than degrading, which
# has taken login down. With these set the API fails over instead; with them
# unset it falls back to allowing the request through unmetered.
UPSTASH_FALLBACK_REDIS_REST_URL=
UPSTASH_FALLBACK_REDIS_REST_TOKEN=

# --- Cloudflare R2, S3-compatible (required): exported reports --------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aevrin-report
R2_S3_ENDPOINT=

# --- GitHub personal access token ------------------------------------------
# Used for Scorecard, OSV/private-repo rate limits, and private clone auth.
# Entirely separate from the GitHub App below; this one does not enable
# "Connect GitHub".
GITHUB_TOKEN=

# --- GitHub App: powers "Connect GitHub for Auto-Fix" -----------------------
# Without all three, Connect returns 503 and Fix It reports itself
# unavailable. Create the App at
#   https://github.com/settings/apps/new
# then read the three values off its settings page. Full walkthrough in the
# repo README under "Connecting GitHub".
#
#   GITHUB_APP_ID           the numeric "App ID" shown at the top of the page
#   GITHUB_APP_SLUG         the last path segment of github.com/apps/<slug>
#   GITHUB_APP_PRIVATE_KEY  contents of the generated .pem, newlines as \n
#
# The private key is a single line here. Convert the downloaded .pem with:
#   awk 'BEGIN{ORS="\\n"} {print}' your-app.private-key.pem
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

# --- Razorpay billing (optional): checkout is disabled while unset ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only the webhook safety net needs this; /billing/verify is the real gate.
RAZORPAY_WEBHOOK_SECRET=

# --- AI triage (optional) ---------------------------------------------------
# Unset means findings are still produced, just without the LLM review pass.
DEEPSEEK_API_KEY=

# --- Encryption at rest (required for the admin panel) ----------------------
# One Fernet key for everything this API stores encrypted: customer-supplied
# BYOK provider keys, and admin TOTP secrets. It sat under "AI triage
# (optional)", which read as BYOK-only; enrolling an authenticator on a
# deployment without it fails with a 503 and locks the panel out entirely.
# Generate with: openssl rand -base64 32 | tr '+/' '-_'
BYOK_ENCRYPTION_KEY=

# --- DefectDojo (optional) --------------------------------------------------
# Leave unset until it's deployed; the scan pipeline runs fine without it,
# the DefectDojo push is best-effort and non-blocking.
DEFECTDOJO_URL=
DEFECTDOJO_API_KEY=

# --- Admin panel (optional) -------------------------------------------------
# Comma-separated Supabase user UUIDs allowed into /admin. Empty means the
# panel is closed to everyone, which is the correct default.
# BYOK_ENCRYPTION_KEY above must also be set, or enrolment cannot store the
# TOTP secret and nobody can get in.
ADMIN_USER_IDS=
ADMIN_SESSION_IDLE_MINUTES=30

# --- MCP marketplace (optional) ---------------------------------------------
# The Supabase user id catalogue (marketplace) scans are attributed to, so
# they never land in a real customer's history or quota. Create a dedicated
# Supabase Auth user for this (no login needed for it, it's never signed in
# as) and paste its id here. Unset disables catalogue scanning -- a refusal
# at the point of use, not an error here.
MARKETPLACE_SCAN_USER_ID=
# Bearer token protecting POST /scheduler/registry-sync, /provider-sync, and
# GET /scheduler/scan-queue -- called by an external scheduler (EventBridge,
# cron), not a signed-in user, so it authenticates with this instead of a
# session. Those routes fail closed (403) while this is unset.
# Generate with: openssl rand -base64 32
SCHEDULER_TOKEN=

# --- AI provider model catalogue (optional) ---------------------------------
# Aevrin's own credentials, used only to refresh the public model catalogue
# shown in the AI-provider settings dropdown -- never a customer's key (every
# provider requires a credential to list models; borrowing a customer's key
# for this bookkeeping would bill them for it). A provider with no key here
# simply is not refreshed: its previously synced models keep working.
GROQ_CATALOG_API_KEY=
OPENAI_CATALOG_API_KEY=
ANTHROPIC_CATALOG_API_KEY=
GEMINI_CATALOG_API_KEY=

# --- Rate limits ------------------------------------------------------------
SCANS_PER_USER_PER_HOUR=10
SCANS_PER_IP_PER_HOUR=20
CLI_UPLOADS_PER_KEY_PER_HOUR=30

# How many reverse proxies in front of this app append to X-Forwarded-For.
# 1 behind a bare AWS ALB or Azure Application Gateway; 2 with CloudFront or
# Front Door in front of that. This picks which entry is treated as the
# caller, and the caller's country picks the checkout currency, so too high a
# value reads a proxy as the client and too low a value trusts the client.
TRUSTED_PROXY_HOPS=1

WEB_ORIGIN=http://localhost:3000
PORT=8000
