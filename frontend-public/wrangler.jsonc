{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aevrin-public",
  "compatibility_date": "2026-08-24",
  // No `main` -- same static-assets-only shape as `frontend-docs/` (see
  // DECISIONS.md ADR-010): `next build` with `output: "export"` produces a
  // plain static site (`out/`), served directly from Cloudflare's asset
  // storage rather than a Worker script, so there's no 3 MiB free-plan
  // Worker-script limit to fit under at all.
  "assets": {
    "directory": "out",
    "not_found_handling": "404-page"
  },
  // Takes over mcp.aevrin.net from frontend/'s Worker (`aevrin-web`), which
  // moved to app.mcp.aevrin.net in the same cutover -- see DECISIONS.md
  // ADR-011. A custom domain can only point at one Worker at a time, so
  // deploying this reassigns the domain away from aevrin-web automatically;
  // deploy frontend/ (claiming app.mcp.aevrin.net) first, so there is no
  // window where neither domain resolves.
  "routes": [
    { "pattern": "mcp.aevrin.net", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
